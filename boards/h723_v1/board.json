{
  "name": "h723_v1",
  "mcu_family": "stm32h7",
  "memory": {
    "dma_policy": "dedicated_section",
    "cache_line_size": 32,
    "dma_accessible_ranges": [
      { "start": "0x24000000", "end": "0x24050000" },
      { "start": "0x30000000", "end": "0x30008000" }
    ]
  },
  "can": {
    "backend": "fdcan",
    "buses": {
      "fdcan1": {
        "tdc": { "enabled": true, "offset": 13, "filter": 13 }
      },
      "fdcan2": {
        "tdc": { "enabled": false, "offset": 0, "filter": 0 }
      },
      "fdcan3": {
        "tdc": { "enabled": false, "offset": 0, "filter": 0 }
      }
    }
  },
  "bindings": {
    "gpio_inputs": {
      "bmi088_gyro_drdy": { "pin": "pe12", "active_level": "high" }
    },
    "gpio_outputs": {
      "bmi088_acc_cs": { "pin": "pc0", "active_level": "low" },
      "bmi088_gyro_cs": { "pin": "pc3", "active_level": "low" }
    },
    "pwm_channels": {
      "bmi088_heater": { "timer": "tim3", "channel": 4 }
    }
  },
  "devices": {
    "bmi088": {
      "enabled": true,
      "spi": "spi2",
      "acc_cs": "bmi088_acc_cs",
      "gyro_cs": "bmi088_gyro_cs",
      "gyro_drdy": "bmi088_gyro_drdy",
      "heater_pwm": "bmi088_heater"
    },
    "led": {
      "enabled": true,
      "spi": "spi6"
    }
  }
}
